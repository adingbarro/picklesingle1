# Postgres connection string. Locally, run `npx prisma dev` to get one for free
# (no Docker required) and paste the DATABASE_URL it prints below.
# On Railway, add a Postgres plugin to your project and Railway will inject
# DATABASE_URL automatically — you generally don't need to set this manually there.
DATABASE_URL="postgresql://user:password@localhost:5432/pickled?schema=public"

# Admin panel login (see src/app/admin/login).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-to-a-random-string"

# Customer login, required before checkout (see src/app/checkout).
CUSTOMER_EMAIL="customer@example.com"
CUSTOMER_PASSWORD="change-me"
# Secret used to sign the customer session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTOMER_SESSION_SECRET="change-me-to-a-random-string"

# "Continue with Google" customer sign-in (see src/lib/auth.ts), offered
# alongside the CUSTOMER_EMAIL/PASSWORD login above. Create an OAuth 2.0
# Client ID at https://console.cloud.google.com/apis/credentials
# (Application type: Web application) with an authorized redirect URI of
# http://localhost:3000/api/auth/callback/google for local dev (add your
# Railway domain's equivalent for production).
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# Secret Auth.js uses to encrypt session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-random-string"
# The app's own public URL. Required in production (e.g. Railway) — without it,
# Auth.js falls back to guessing the URL from the request, which behind a proxy
# resolves to the container's internal address instead of your real domain and
# breaks the Google OAuth callback (error=Configuration). Not needed locally,
# where it correctly infers http://localhost:3000.
# AUTH_URL="https://your-production-domain.com"
